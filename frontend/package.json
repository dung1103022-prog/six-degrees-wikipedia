{
  "name": "sixth-degree-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Six Degrees of Wikipedia (Python) - frontend. Contract: ../SPEC.md (Phase 4)",
  "scripts": {
    "dev": "vite",
    "gen:types": "node scripts/gen-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "3d-force-graph": "1.80.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
